# ============================================================================
# OPPORA — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your Supabase project credentials.
# Never commit .env.local or secret service role keys to version control.
# ============================================================================

# Public site URL (used for SEO canonical links, OpenGraph, sitemap, WhatsApp sharing)
NEXT_PUBLIC_SITE_URL=https://oppora-pi.vercel.app

# Supabase Public Configuration (Safe for browser when RLS policies are enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Storage Bucket Name for validated listing images
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=oppora-listings

# Server-Only Admin / Moderation Key (NEVER prefix with NEXT_PUBLIC_)
# Used only in server-side API routes for elevated administrative tasks if needed
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
OPPORA_ADMIN_PASSCODE=oppora-ghana-mod-2026
